# --- runtime safety ---
# Hard safety rail: when ON, only simulated channel adapters can be constructed.
SIMULATION_MODE=on

# --- LLM generator (OPTIONAL stretch). When unset, the deterministic
# TemplateGenerator is used and the demo runs fully offline.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# --- scheduler ---
# Heartbeat interval in seconds (use 10 for demo mode).
HEARTBEAT_INTERVAL_SECONDS=300

# --- app ---
GTM_DB_PATH=gtm-loop.db
GTM_HOST=127.0.0.1
GTM_PORT=8000
